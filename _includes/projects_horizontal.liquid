<div class="col mb-4">
  <div class="card project-card h-100 hoverable{% if project.first_author %} featured{% endif %}">
    <div class="project-card-layout">
      {% if project.img %}
        <a class="project-card-media" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" aria-label="{{ project.title }}">
          {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 180px, 90vw" alt=project.title class="card-img" %}
        </a>
      {% endif %}
      <div class="project-card-content">
        <div class="project-card-meta">
          {% if project.venue %}
            <span class="proj-chip project-venue">{{ project.venue }}</span>
          {% endif %}
          {% if project.first_author %}
            <span class="proj-chip proj-chip--accent">First author</span>
          {% endif %}
        </div>
        <h3 class="project-card-title">
          <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
        </h3>
        <p class="card-text">{{ project.description }}</p>
        <div class="project-card-actions">
          <a class="project-card-action primary" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">Project details</a>
          {% if project.website %}
            <a class="project-card-action" href="{{ project.website }}">Project site</a>
          {% endif %}
          {% if project.github %}
            <a class="project-card-action icon" href="{{ project.github }}" data-toggle="tooltip" title="Code repository"><i class="fa-brands fa-github gh-icon"></i></a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
